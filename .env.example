APP_NAME=enterprise-research-agent
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_agent
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_agent
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
ALLOWED_SEARCH_DOMAINS=arxiv.org,paperswithcode.com,developers.google.com,aws.amazon.com,nist.gov,nih.gov,who.int,scikit-learn.org,pytorch.org,tensorflow.org
CHROMA_DIR=./.chroma
RAG_COLLECTION=research_documents
RAG_TOP_K=5
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-research-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
MAX_QUERY_LENGTH=4000
MAX_RESEARCH_QUERIES=5
RATE_LIMIT=30/minute
